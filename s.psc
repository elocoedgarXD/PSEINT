Algoritmo sin_titulo
	Definir oro, plata, bonce, certificado Como Entero
	
	
	Escribir "puesto del piloto "
	Leer puesto
	si puesto = 1
	SiNo
		
		Escribir "entregar medalla de oro "
		si puesto = 2
		SiNo
			
			Escribir "entregar medalla de plata "
			si puesto = 3
			SiNo
				
				Escribir "entregar medalla de bronce "
				si puesto = 4
					Escribir "entregar certificado de precentasion "
			
	FinSi
	
	
	
	
	
FinAlgoritmo
